# ╔══════════════════════════════════════════════════════════════════════╗
# ║  J.A.R.V.I.S. – Konfiguration                                        ║
# ║  Kopiere diese Datei nach `.env.local` und trage deine Werte ein.    ║
# ║  `.env.local` wird NIE committet – API-Schlüssel bleiben auf dem     ║
# ║  Server und gelangen niemals in den Browser.                         ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── KI-Anbieter ─────────────────────────────────────────────────────────
# anthropic | openai | demo | auto
# auto = Anthropic, falls ANTHROPIC_API_KEY gesetzt ist, sonst OpenAI,
#        sonst der Demo-Modus (funktioniert ohne Schlüssel, ohne echte KI).
AI_PROVIDER=auto
# Optionaler Ersatzanbieter, falls der primäre Anbieter ausfällt
# (z. B. openai, anthropic oder demo). Leer lassen = kein Fallback.
AI_FALLBACK_PROVIDER=

# Anthropic Claude (empfohlen) – Schlüssel: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Denkaufwand (low | medium | high | xhigh | max). Für Sprache ist "low"
# deutlich schneller; leer lassen = Modell-Standard.
ANTHROPIC_EFFORT_TEXT=medium
ANTHROPIC_EFFORT_VOICE=low
ANTHROPIC_MAX_TOKENS=32000
# Serverseitiger Fallback auf ein anderes Claude-Modell, falls eine Anfrage
# von Sicherheitsfiltern abgelehnt wird (empfohlen).
ANTHROPIC_REFUSAL_FALLBACK=true
# Websuche über Anthropic (kostet ca. 0,01 $ pro Suche zusätzlich).
ANTHROPIC_WEB_SEARCH=false
# Nur setzen, wenn ein Proxy/Gateway vor der Anthropic-API verwendet wird.
ANTHROPIC_BASE_URL=

# OpenAI oder OpenAI-kompatible Anbieter (OpenRouter, Groq, Ollama, LM Studio …)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# z. B. http://localhost:11434/v1 für Ollama oder https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# ── Sprachausgabe (Text-to-Speech) ──────────────────────────────────────
# auto | openai | elevenlabs | none
# Ohne Server-TTS nutzt JARVIS automatisch die Stimmen des Browsers.
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
# Sprechstil für gpt-4o-mini-tts (frei formulierbar)
OPENAI_TTS_INSTRUCTIONS=Sprich ruhig, souverän und höflich wie ein britischer KI-Butler: klare Artikulation, gemäßigtes Tempo, ein Hauch trockener Humor.
# ElevenLabs – sehr natürliche Stimmen: https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Spracheingabe (Speech-to-Text) ──────────────────────────────────────
# auto | openai | none
# Standard ist die Spracherkennung des Browsers (Chrome, Edge, Safari).
# Mit OpenAI funktioniert die Spracheingabe zusätzlich in Firefox & Co.
STT_PROVIDER=auto
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ── Datenbank (Chatverläufe, Profil, Gedächtnis) ────────────────────────
# Lokal: SQLite-Datei. In der Cloud (z. B. Vercel): Turso/libSQL-URL
# (libsql://<db>.turso.io) plus Token.
DATABASE_URL=file:./data/jarvis.db
DATABASE_AUTH_TOKEN=

# ── Sicherheit ──────────────────────────────────────────────────────────
# Zugangscode für die Weboberfläche. DRINGEND setzen, sobald JARVIS im
# Internet erreichbar ist – sonst kann jeder deine API-Guthaben verbrauchen.
JARVIS_ACCESS_CODE=
# Geheimnis zum Signieren der Sitzungs-Cookies (mind. 32 zufällige Zeichen),
# z. B. erzeugt mit: openssl rand -base64 48
JARVIS_SESSION_SECRET=
# Maximale Chat-Anfragen pro Minute und IP-Adresse
RATE_LIMIT_PER_MINUTE=30

# ── Fähigkeiten (Skills) ────────────────────────────────────────────────
# Wetter über Open-Meteo (kostenlos, kein Schlüssel nötig)
SKILL_WEATHER=true
# Persönliches Gedächtnis (merkt sich Fakten über dich)
SKILL_MEMORY=true
