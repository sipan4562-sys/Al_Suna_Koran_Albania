{
  "name": "Pixelkingschat",
  "short_name": "Pixelkings",
  "description": "Anonymer, verschlüsselter Chat ohne Nummer oder Mail.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "lang": "de",
  "categories": ["social", "communication"],
  "shortcuts": [
    { "name": "Kontakt hinzufügen", "short_name": "Hinzufügen", "url": "/#new", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "QR-Code scannen", "short_name": "Scannen", "url": "/#scan", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "background_color": "#050708",
  "theme_color": "#050708",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
